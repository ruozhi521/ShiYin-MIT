<?xml version="1.0" encoding="utf-8"?>
<!-- 发现页「主推荐」大卡片（2.16）：整行铺满，封面更高、标题更大，
     与下方两列「更多随机推荐」形成主次层次（此前全部是等大双列网格）。
     id 特意与 item_discover_card 不同，避免与 RecyclerView 内的条目混淆。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:foreground="?attr/selectableItemBackground"
    android:orientation="vertical">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="196dp">

        <ImageView
            android:id="@+id/imgPrimaryCover"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_cover"
            android:clipToOutline="true"
            android:contentDescription="@string/cover"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_music_tinted" />

        <TextView
            android:id="@+id/txtPrimaryBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|start"
            android:layout_margin="10dp"
            android:background="@drawable/bg_badge_on_photo"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:text="@string/discover_primary_badge"
            android:textColor="@color/white"
            android:textSize="11sp" />
    </FrameLayout>

    <TextView
        android:id="@+id/txtPrimaryTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:ellipsize="end"
        android:singleLine="true"
        android:textColor="@color/text_primary"
        android:textSize="19sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/txtPrimaryArtist"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:ellipsize="end"
        android:singleLine="true"
        android:textColor="@color/text_hint"
        android:textSize="13sp" />

</LinearLayout>
