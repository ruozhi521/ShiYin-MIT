<?xml version="1.0" encoding="utf-8"?>
<!--
  3.0.3：视频列表页与音乐库 / 发现页统一。
  · 去掉左上角的返回键 —— 本页是底部导航的一个 tab（和音乐库 / 发现 / 歌单一样），
    本来就没有「上级」可回；其他 tab 也都没有返回键，它是唯一的孤例。
  · 标题 16sp 居中 → 30sp 左对齐（与音乐库 / 发现页的 .title 同规格）。
  · 补一行副标题（视频数量），页面结构与音乐库页对齐（标题 → 副标题 → 内容）。
  · 页面 padding 20dp（与其他页一致；列表本身仍留 6/12dp 内边距）。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/pageVideos"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp"
    android:visibility="gone">

    <TextView
        android:id="@+id/txtVideosTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/tab_video"
        android:textColor="@color/text_primary"
        android:textSize="30sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/txtVideosSubtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textColor="@color/text_hint"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/txtVideosEmpty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="40dp"
        android:gravity="center"
        android:text="@string/videos_empty"
        android:textColor="@color/text_hint"
        android:textSize="14sp"
        android:visibility="gone" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerVideos"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="6dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingTop="6dp"
        android:paddingBottom="12dp" />

</LinearLayout>
