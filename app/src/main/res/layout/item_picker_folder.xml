<?xml version="1.0" encoding="utf-8"?>
<!-- 选歌器：文件夹行（3.0.6）。多选模式下左侧出现勾选标记。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:foreground="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:minHeight="56dp"
    android:orientation="horizontal"
    android:paddingStart="6dp"
    android:paddingEnd="6dp"
    android:paddingTop="6dp"
    android:paddingBottom="6dp">

    <ImageView
        android:id="@+id/imgPickerFolderCheck"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginEnd="6dp"
        android:src="@drawable/ic_check_off"
        android:visibility="gone" />

    <ImageView
        android:id="@+id/imgPickerFolderIcon"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@drawable/bg_cover"
        android:clipToOutline="true"
        android:contentDescription="@string/cover"
        android:padding="8dp"
        android:src="@drawable/ic_folder_tinted" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/txtPickerFolderName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:singleLine="true"
            android:textColor="@color/text_primary"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/txtPickerFolderCount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:singleLine="true"
            android:textColor="@color/text_hint"
            android:textSize="12sp" />
    </LinearLayout>

    <ImageView
        android:id="@+id/imgPickerFolderArrow"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:contentDescription="@string/next"
        android:src="@drawable/ic_next"
        android:tint="@color/text_hint" />
</LinearLayout>
