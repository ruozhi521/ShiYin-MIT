<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingEnd="20dp"
    android:paddingTop="8dp">

    <!--
      翻译方式下拉（3.0 补齐「不够明显」）：
      背景必须是 bg_spinner —— 它保留了圆角面**并在右侧画出下拉箭头**。
      原来用 bg_mini 会把系统默认箭头盖掉，用户看不出这是可选项。
      paddingEnd 必须 ≥32dp，否则文字会压到箭头上（箭头宽 12dp + 右距 14dp）。
    -->
    <Spinner
        android:id="@+id/spTransProvider"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_spinner"
        android:entries="@array/trans_provider_entries"
        android:paddingStart="10dp"
        android:paddingEnd="36dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp" />


    <EditText
        android:id="@+id/etTransBase"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_mini"
        android:hint="@string/trans_base_hint"
        android:inputType="textUri"
        android:maxLines="1"
        android:padding="10dp"
        android:textColor="@color/text_primary"
        android:textColorHint="@color/text_hint"
        android:textSize="14sp" />

    <EditText
        android:id="@+id/etTransKey"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_mini"
        android:hint="@string/trans_key_hint"
        android:inputType="textPassword"
        android:maxLines="1"
        android:padding="10dp"
        android:textColor="@color/text_primary"
        android:textColorHint="@color/text_hint"
        android:textSize="14sp" />

    <EditText
        android:id="@+id/etTransModel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_mini"
        android:hint="@string/trans_model_hint"
        android:inputType="text"
        android:maxLines="1"
        android:padding="10dp"
        android:textColor="@color/text_primary"
        android:textColorHint="@color/text_hint"
        android:textSize="14sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="@string/trans_privacy"
        android:textColor="@color/text_hint"
        android:textSize="12sp" />

    <!--
      本地离线翻译（3.1）：模型在设备上跑，需要一份约 216 MB 的本地模型。
      与线上 provider 的区别就在这里，故单独给出「状态 + 下载/删除」入口。
      仅当 provider 选到「本地离线」时显示（由代码控制 visibility）。
    -->
    <LinearLayout
        android:id="@+id/localMtRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:id="@+id/txtMtStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/text_hint"
            android:textSize="13sp"
            tools:text="模型未下载（0/3 个文件）" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnMtDownload"
                style="@style/BtnStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="5dp"
                android:layout_weight="1"
                android:text="@string/mt_download_model" />

            <Button
                android:id="@+id/btnMtDelete"
                style="@style/BtnStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:layout_weight="1"
                android:text="@string/mt_delete_model" />
        </LinearLayout>

        <!--
          解码质量开关（3.0）。放在 localMtRow 内是刻意的：
          mtBeams 只在 TranslationEngine 的 LOCAL 分支被读取，云端 provider 下无效，
          跟着 localMtRow 显隐就不会对云端用户造成「调了没反应」的误解。
          默认关（贪心）—— 手机端无 KV cache，beam 会成倍拉长耗时。
        -->
        <android.widget.Switch
            android:id="@+id/swMtBeams"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/mt_beams_title"
            android:textColor="@color/text_primary"
            android:textSize="15sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/mt_beams_hint"
            android:textColor="@color/text_hint"
            android:textSize="12sp" />
    </LinearLayout>

</LinearLayout>
