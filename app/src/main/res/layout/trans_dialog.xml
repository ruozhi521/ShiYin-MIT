<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingEnd="20dp"
    android:paddingTop="8dp">

    <Spinner
        android:id="@+id/spTransProvider"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_mini"
        android:entries="@array/trans_provider_entries"
        android:padding="10dp" />

    <EditText
        android:id="@+id/etTransBase"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_mini"
        android:hint="@string/trans_base_hint"
        android:inputType="textUri"
        android:maxLines="1"
        android:padding="10dp"
        android:textColor="@color/text_primary"
        android:textColorHint="@color/text_hint"
        android:textSize="14sp" />

    <EditText
        android:id="@+id/etTransKey"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_mini"
        android:hint="@string/trans_key_hint"
        android:inputType="textPassword"
        android:maxLines="1"
        android:padding="10dp"
        android:textColor="@color/text_primary"
        android:textColorHint="@color/text_hint"
        android:textSize="14sp" />

    <EditText
        android:id="@+id/etTransModel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_mini"
        android:hint="@string/trans_model_hint"
        android:inputType="text"
        android:maxLines="1"
        android:padding="10dp"
        android:textColor="@color/text_primary"
        android:textColorHint="@color/text_hint"
        android:textSize="14sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="@string/trans_privacy"
        android:textColor="@color/text_hint"
        android:textSize="12sp" />

    <!--
      本地离线翻译（3.1）：模型在设备上跑，需要一份约 216 MB 的本地模型。
      与线上 provider 的区别就在这里，故单独给出「状态 + 下载/删除」入口。
      仅当 provider 选到「本地离线」时显示（由代码控制 visibility）。
    -->
    <LinearLayout
        android:id="@+id/localMtRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:id="@+id/txtMtStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/text_hint"
            android:textSize="13sp"
            tools:text="模型未下载（0/3 个文件）" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnMtDownload"
                style="@style/BtnStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="5dp"
                android:layout_weight="1"
                android:text="@string/mt_download_model" />

            <Button
                android:id="@+id/btnMtDelete"
                style="@style/BtnStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:layout_weight="1"
                android:text="@string/mt_delete_model" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
