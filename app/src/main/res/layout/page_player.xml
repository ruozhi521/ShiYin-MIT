<?xml version="1.0" encoding="utf-8"?>
<com.example.subtitleplayer.SwipeFrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/pagePlayer" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:paddingStart="24dp" android:paddingEnd="24dp"
    android:paddingTop="8dp" android:paddingBottom="8dp" android:visibility="gone">
    <LinearLayout android:id="@+id/playerHeader" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
        <Button android:id="@+id/btnBackSongs" style="@style/BtnStyle" android:layout_width="wrap_content" android:layout_height="48dp" android:text="@string/back" />
        <Space android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
        <TextView android:id="@+id/btnFavorite" android:layout_width="48dp" android:layout_height="48dp" android:gravity="center" android:background="?attr/selectableItemBackgroundBorderless" android:contentDescription="@string/favorite" android:text="♡" android:textColor="@color/text_hint" android:textSize="28sp" />
        <Button android:id="@+id/btnLyrics" style="@style/BtnStyle" android:layout_width="wrap_content" android:layout_height="48dp" android:text="@string/lyric_btn" />
    </LinearLayout>
    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="8dp">
        <ImageView android:id="@+id/imgCd" android:layout_width="280dp" android:layout_height="280dp" android:layout_gravity="center" android:background="@drawable/bg_cover" android:clipToOutline="true" android:scaleType="centerCrop" android:contentDescription="@string/cover" android:src="@drawable/ic_music_tinted" />
        <ImageView android:id="@+id/imgCdHole" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone" android:contentDescription="@string/cd_hole" />
    </FrameLayout>
    <TextView android:id="@+id/txtPlayerTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:ellipsize="end" android:singleLine="true" android:textColor="@color/text_primary" android:textSize="26sp" android:textStyle="bold" />
    <TextView android:id="@+id/txtPlayerFolder" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:ellipsize="middle" android:singleLine="true" android:textColor="@color/text_hint" android:textSize="13sp" />
    <TextView android:id="@+id/txtNowLyric" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:minHeight="48dp" android:gravity="center_vertical" android:ellipsize="end" android:singleLine="true" android:text="@string/no_lyric_now" android:textColor="@color/accent" android:textSize="17sp" />
    <TextView android:id="@+id/txtImmersiveLyric" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:lineSpacingExtra="6dp" android:textColor="@color/text_primary" android:textSize="16sp" android:visibility="gone" />
    <SeekBar android:id="@+id/seekBar" android:layout_width="match_parent" android:layout_height="36dp" android:layout_marginTop="4dp" android:max="0" android:maxHeight="4dp" android:minHeight="4dp" android:paddingStart="0dp" android:paddingEnd="0dp" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:orientation="horizontal">
        <TextView android:id="@+id/txtTime" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="00:00" android:textColor="@color/text_hint" android:textSize="12sp" />
        <Space android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
        <TextView android:id="@+id/txtTimeTotal" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="00:00" android:textColor="@color/text_hint" android:textSize="12sp" />
    </LinearLayout>
    <LinearLayout android:id="@+id/playerControlsMain" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:gravity="center">
        <ImageButton android:id="@+id/btnPrev" android:layout_width="56dp" android:layout_height="56dp" android:background="?attr/selectableItemBackgroundBorderless" android:contentDescription="@string/prev" android:src="@drawable/ic_prev" android:tint="@color/text_primary" />
        <ImageButton android:id="@+id/btnPlayPlayer" android:layout_width="72dp" android:layout_height="72dp" android:layout_marginStart="24dp" android:layout_marginEnd="24dp" android:background="@drawable/bg_play_circle" android:contentDescription="@string/play" android:src="@drawable/ic_play" />
        <ImageButton android:id="@+id/btnNext" android:layout_width="56dp" android:layout_height="56dp" android:background="?attr/selectableItemBackgroundBorderless" android:contentDescription="@string/next" android:src="@drawable/ic_next" android:tint="@color/text_primary" />
    </LinearLayout>
    <LinearLayout android:id="@+id/playerControlsExtra" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="6dp" android:gravity="center">
        <ImageButton android:id="@+id/btnTimer" style="@style/PlayerTool" android:contentDescription="@string/timer" android:src="@drawable/ic_timer" />
        <ImageButton android:id="@+id/btnPlayMode" style="@style/PlayerTool" android:contentDescription="@string/play_mode_sequence" android:src="@drawable/ic_repeat" />
        <ImageButton android:id="@+id/btnQueue" style="@style/PlayerTool" android:contentDescription="@string/queue" android:src="@drawable/ic_queue" />
        <ImageButton android:id="@+id/btnLyricsIcon" style="@style/PlayerTool" android:contentDescription="@string/lyrics_full" android:src="@drawable/ic_lyric" />
        <ImageButton android:id="@+id/btnVideo" style="@style/PlayerTool" android:contentDescription="@string/video_btn" android:src="@drawable/ic_video" android:visibility="gone" />
        <!-- 3.0.3：左右声道反转（显隐由「设置 → 主题」控制，默认隐藏以免工具行臃肿） -->
        <ImageButton android:id="@+id/btnChannelFlip" style="@style/PlayerTool" android:contentDescription="@string/channel_flip_on" android:src="@drawable/ic_channel_flip" android:visibility="gone" />
    </LinearLayout>
    <LinearLayout android:id="@+id/playerControlsSeek" android:layout_width="match_parent" android:layout_height="48dp" android:gravity="center">
        <TextView android:id="@+id/btnSeekBack" style="@style/PlayerSeekTool" android:text="-10s" />
        <TextView android:id="@+id/btnSpeed" style="@style/PlayerSeekTool" android:text="1x" />
        <TextView android:id="@+id/btnSeekForward" style="@style/PlayerSeekTool" android:text="+10s" />
    </LinearLayout>
</com.example.subtitleplayer.SwipeFrameLayout>
