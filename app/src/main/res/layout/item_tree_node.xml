<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rowTree"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingTop="8dp"
    android:paddingEnd="12dp"
    android:paddingBottom="8dp">

    <TextView
        android:id="@+id/txtTreeArrow"
        android:layout_width="24dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textColor="@color/text_hint"
        android:textSize="14sp"
        android:visibility="gone" />

    <FrameLayout
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginStart="6dp"
        android:layout_marginEnd="10dp">

        <ImageView
            android:id="@+id/imgTreeCover"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_cover"
            android:clipToOutline="true"
            android:contentDescription="@string/cover"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_folder_tinted" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/txtTreeName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:singleLine="true"
            android:textColor="@color/text_primary"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/txtTreeCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/text_hint"
            android:textSize="11sp" />
    </LinearLayout>

    <!--
      3.0.6：树形目录的拖拽把手（粉丝反馈「树形目录希望可以增加拖动排序功能」）。
      与网格版同一套约定：按住这里才拖，长按行仍走菜单。
      放在行尾而不是左上角：树形行是窄条，左上角已被缩进/箭头占住。
    -->
    <ImageView
        android:id="@+id/imgTreeDragHandle"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/song_drag_handle"
        android:padding="6dp"
        android:src="@drawable/ic_drag_handle"
        android:tint="@color/text_hint"
        android:visibility="gone" />

</LinearLayout>
