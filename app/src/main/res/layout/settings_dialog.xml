<?xml version="1.0" encoding="utf-8"?>
<!-- 设置：分组卡片式。所有 View id / tag 与原布局一致，MainActivity 接线零改动。 -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:overScrollMode="ifContentScrolls"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="2dp"
        android:paddingBottom="10dp">

        <!-- ════════ 媒体库 ════════ -->
        <TextView
            style="@style/SettingsSection"
            android:layout_marginTop="2dp"
            android:text="@string/settings_cat_library" />

        <LinearLayout style="@style/SettingsCard">

            <CheckBox
                android:id="@+id/chkAutoScan"
                style="@style/SettingsSwitch"
                android:text="@string/auto_scan" />

            <View style="@style/SettingsDivider" />

            <CheckBox
                android:id="@+id/chkTitleFromFilename"
                style="@style/SettingsSwitch"
                android:text="@string/title_from_filename" />

            <TextView
                style="@style/SettingsHint"
                android:text="@string/title_from_filename_hint" />

            <View style="@style/SettingsDivider" />

            <TextView
                style="@style/SettingsLabel"
                android:layout_marginTop="10dp"
                android:text="@string/lib_layout" />

            <RadioGroup
                android:id="@+id/rgLibLayout"
                style="@style/SettingsSegment">

                <RadioButton
                    android:id="@+id/rbLibGrid"
                    style="@style/SettingsSegItem"
                    android:tag="0"
                    android:text="@string/lib_grid" />

                <RadioButton
                    android:id="@+id/rbLibTree"
                    style="@style/SettingsSegItem"
                    android:tag="1"
                    android:text="@string/lib_tree" />
            </RadioGroup>

            <LinearLayout style="@style/SettingsBtnRow">

                <Button
                    android:id="@+id/btnRescanNow"
                    style="@style/BtnStyle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="5dp"
                    android:layout_weight="1"
                    android:text="@string/rescan" />

                <Button
                    android:id="@+id/btnChangeFolder"
                    style="@style/BtnStyle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:layout_weight="1"
                    android:text="@string/change_folder" />
            </LinearLayout>
        </LinearLayout>

        <!-- ════════ 歌词 ════════ -->
        <TextView
            style="@style/SettingsSection"
            android:text="@string/settings_cat_lyrics" />

        <LinearLayout style="@style/SettingsCard">

            <CheckBox
                android:id="@+id/chkAutoTrans"
                style="@style/SettingsSwitch"
                android:text="@string/auto_trans" />

            <TextView
                style="@style/SettingsHint"
                android:text="@string/auto_trans_hint" />

            <View style="@style/SettingsDivider" />

            <CheckBox
                android:id="@+id/chkLyricon"
                style="@style/SettingsSwitch"
                android:text="@string/lyricon_enabled" />

            <TextView
                style="@style/SettingsHint"
                android:text="@string/lyricon_hint" />

            <View style="@style/SettingsDivider" />

            <TextView
                style="@style/SettingsLabel"
                android:layout_marginTop="10dp"
                android:text="@string/lyric_size_label" />

            <RadioGroup
                android:id="@+id/rgLyricSize"
                style="@style/SettingsSegment">

                <RadioButton
                    android:id="@+id/rbLyricSmall"
                    style="@style/SettingsSegItem"
                    android:tag="15"
                    android:text="@string/size_small" />

                <RadioButton
                    android:id="@+id/rbLyricMid"
                    style="@style/SettingsSegItem"
                    android:tag="18"
                    android:text="@string/size_medium" />

                <RadioButton
                    android:id="@+id/rbLyricLarge"
                    style="@style/SettingsSegItem"
                    android:tag="22"
                    android:text="@string/size_large" />
            </RadioGroup>

            <TextView
                style="@style/SettingsLabel"
                android:text="@string/lyric_font_label" />

            <RadioGroup
                android:id="@+id/rgFont"
                style="@style/SettingsSegment"
                android:layout_marginBottom="4dp">

                <RadioButton
                    android:id="@+id/rbFontDefault"
                    style="@style/SettingsSegItem"
                    android:tag="0"
                    android:text="@string/font_default" />

                <RadioButton
                    android:id="@+id/rbFontSerif"
                    style="@style/SettingsSegItem"
                    android:tag="1"
                    android:text="@string/font_serif" />

                <RadioButton
                    android:id="@+id/rbFontMono"
                    style="@style/SettingsSegItem"
                    android:tag="2"
                    android:text="@string/font_mono" />
            </RadioGroup>
        </LinearLayout>

        <!-- ════════ 桌面歌词 ════════ -->
        <TextView
            style="@style/SettingsSection"
            android:text="@string/settings_cat_desktop" />

        <LinearLayout style="@style/SettingsCard">

            <CheckBox
                android:id="@+id/chkDesktopLyrics"
                style="@style/SettingsSwitch"
                android:text="@string/desktop_lyrics_label" />

            <LinearLayout
                android:id="@+id/lyricsGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <View style="@style/SettingsDivider" />

                <TextView
                    style="@style/SettingsLabel"
                    android:layout_marginTop="10dp"
                    android:text="@string/desktop_lyrics_size_label" />

                <RadioGroup
                    android:id="@+id/rgDesktopSize"
                    style="@style/SettingsSegment">

                    <RadioButton
                        android:id="@+id/rbDesktopSizeS"
                        style="@style/SettingsSegItem"
                        android:tag="0"
                        android:text="@string/size_small" />

                    <RadioButton
                        android:id="@+id/rbDesktopSizeM"
                        style="@style/SettingsSegItem"
                        android:tag="1"
                        android:text="@string/size_medium" />

                    <RadioButton
                        android:id="@+id/rbDesktopSizeL"
                        style="@style/SettingsSegItem"
                        android:tag="2"
                        android:text="@string/size_large" />
                </RadioGroup>

                <TextView
                    style="@style/SettingsLabel"
                    android:text="@string/desktop_lyrics_alpha_label" />

                <RadioGroup
                    android:id="@+id/rgDesktopAlpha"
                    style="@style/SettingsSegment">

                    <RadioButton
                        android:id="@+id/rbDesktopAlpha0"
                        style="@style/SettingsSegItem"
                        android:textSize="12sp"
                        android:tag="0"
                        android:text="@string/desktop_lyrics_alpha_0" />

                    <RadioButton
                        android:id="@+id/rbDesktopAlpha1"
                        style="@style/SettingsSegItem"
                        android:textSize="12sp"
                        android:tag="1"
                        android:text="@string/desktop_lyrics_alpha_1" />

                    <RadioButton
                        android:id="@+id/rbDesktopAlpha2"
                        style="@style/SettingsSegItem"
                        android:textSize="12sp"
                        android:tag="2"
                        android:text="@string/desktop_lyrics_alpha_2" />

                    <RadioButton
                        android:id="@+id/rbDesktopAlpha3"
                        style="@style/SettingsSegItem"
                        android:textSize="12sp"
                        android:tag="3"
                        android:text="@string/desktop_lyrics_alpha_3" />
                </RadioGroup>

                <Button
                    android:id="@+id/btnDesktopColor"
                    style="@style/BtnStyle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_marginEnd="12dp"
                    android:layout_marginTop="12dp"
                    android:text="@string/desktop_lyrics_color" />

                <View
                    style="@style/SettingsDivider"
                    android:layout_marginTop="10dp" />

                <CheckBox
                    android:id="@+id/chkLyricsLocked"
                    style="@style/SettingsSwitch"
                    android:text="@string/desktop_lyrics_locked" />

                <View style="@style/SettingsDivider" />

                <CheckBox
                    android:id="@+id/chkDesktopCenter"
                    style="@style/SettingsSwitch"
                    android:text="@string/desktop_lyrics_center" />

                <TextView
                    style="@style/SettingsHint"
                    android:text="@string/desktop_lyrics_center_hint" />
            </LinearLayout>
        </LinearLayout>

        <!-- ════════ 播放 ════════ -->
        <TextView
            style="@style/SettingsSection"
            android:text="@string/settings_cat_playback" />

        <LinearLayout style="@style/SettingsCard">

            <CheckBox
                android:id="@+id/chkMixAudio"
                style="@style/SettingsSwitch"
                android:text="@string/mix_audio_label" />

            <TextView
                style="@style/SettingsHint"
                android:text="@string/mix_audio_hint" />

            <View style="@style/SettingsDivider" />

            <CheckBox
                android:id="@+id/chkAlarmPlay"
                style="@style/SettingsSwitch"
                android:text="@string/alarm_play" />

            <TextView
                style="@style/SettingsHint"
                android:text="@string/alarm_play_hint" />

            <View style="@style/SettingsDivider" />

            <CheckBox
                android:id="@+id/chkAlarmOnce"
                style="@style/SettingsSwitch"
                android:text="@string/alarm_once_label" />

            <TextView
                style="@style/SettingsHint"
                android:text="@string/alarm_once_hint" />

            <View style="@style/SettingsDivider" />

            <CheckBox
                android:id="@+id/chkPerSong"
                style="@style/SettingsSwitch"
                android:text="@string/per_song_label" />

            <TextView
                style="@style/SettingsHint"
                android:text="@string/per_song_hint" />

            <View style="@style/SettingsDivider" />

            <TextView
                style="@style/SettingsLabel"
                android:layout_marginTop="10dp"
                android:text="@string/seek_step_label" />

            <RadioGroup
                android:id="@+id/rgSeekStep"
                style="@style/SettingsSegment">

                <RadioButton
                    style="@style/SettingsSegItem"
                    android:tag="1"
                    android:text="1s" />

                <RadioButton
                    style="@style/SettingsSegItem"
                    android:tag="2"
                    android:text="2s" />

                <RadioButton
                    style="@style/SettingsSegItem"
                    android:tag="5"
                    android:text="5s" />

                <RadioButton
                    style="@style/SettingsSegItem"
                    android:tag="10"
                    android:text="10s" />

                <RadioButton
                    style="@style/SettingsSegItem"
                    android:tag="15"
                    android:text="15s" />

                <RadioButton
                    style="@style/SettingsSegItem"
                    android:tag="30"
                    android:text="30s" />
            </RadioGroup>

            <Button
                android:id="@+id/btnEqSettings"
                style="@style/BtnStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="6dp"
                android:text="@string/eq_entry" />
        </LinearLayout>

        <!-- ════════ 外观 ════════ -->
        <TextView
            style="@style/SettingsSection"
            android:text="@string/settings_cat_appearance" />

        <LinearLayout style="@style/SettingsCard">

            <TextView
                style="@style/SettingsLabel"
                android:layout_marginTop="10dp"
                android:text="@string/ui_size_label" />

            <RadioGroup
                android:id="@+id/rgUiSize"
                style="@style/SettingsSegment">

                <RadioButton
                    android:id="@+id/rbUiSmall"
                    style="@style/SettingsSegItem"
                    android:tag="13"
                    android:text="@string/size_small" />

                <RadioButton
                    android:id="@+id/rbUiStd"
                    style="@style/SettingsSegItem"
                    android:tag="15"
                    android:text="@string/size_standard" />

                <RadioButton
                    android:id="@+id/rbUiLarge"
                    style="@style/SettingsSegItem"
                    android:tag="17"
                    android:text="@string/size_large" />
            </RadioGroup>

            <Button
                android:id="@+id/btnTheme"
                style="@style/BtnStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="6dp"
                android:text="@string/theme_entry" />
        </LinearLayout>

        <!-- ════════ 工具 ════════ -->
        <TextView
            style="@style/SettingsSection"
            android:text="@string/settings_cat_tools" />

        <LinearLayout style="@style/SettingsCard"
            android:paddingBottom="2dp">

            <LinearLayout style="@style/SettingsBtnRow"
                android:layout_marginBottom="2dp">

                <Button
                    android:id="@+id/btnAsrEntry"
                    style="@style/BtnStyle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="5dp"
                    android:layout_weight="1"
                    android:text="@string/asr_entry" />

                <Button
                    android:id="@+id/btnTransSettings"
                    style="@style/BtnStyle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:layout_weight="1"
                    android:text="@string/trans_settings" />
            </LinearLayout>

            <LinearLayout style="@style/SettingsBtnRow"
                android:layout_marginTop="4dp">

                <Button
                    android:id="@+id/btnExportLog"
                    style="@style/BtnStyle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="5dp"
                    android:layout_weight="1"
                    android:text="@string/playback_log_btn" />

                <Button
                    android:id="@+id/btnAbout"
                    style="@style/BtnStyle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:layout_weight="1"
                    android:text="@string/about" />
            </LinearLayout>

            <TextView
                style="@style/SettingsHint"
                android:layout_marginTop="0dp"
                android:text="@string/playback_log_hint" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
