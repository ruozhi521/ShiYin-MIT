<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="12dp"
        android:paddingBottom="4dp">

        <CheckBox
            android:id="@+id/chkAutoScan"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/auto_scan"
            android:textColor="@color/text_primary"
            android:textSize="15sp" />

        <CheckBox
            android:id="@+id/chkAutoTrans"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/auto_trans"
            android:textColor="@color/text_primary"
            android:textSize="15sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="30dp"
            android:text="@string/auto_trans_hint"
            android:textColor="@color/text_hint"
            android:textSize="12sp" />

        <CheckBox
            android:id="@+id/chkLyricon"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/lyricon_enabled"
            android:textColor="@color/text_primary"
            android:textSize="15sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="30dp"
            android:layout_marginTop="2dp"
            android:text="@string/lyricon_hint"
            android:textColor="@color/text_hint"
            android:textSize="12sp" />

        <CheckBox
            android:id="@+id/chkDesktopLyrics"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/desktop_lyrics_label"
            android:textColor="@color/text_primary"
            android:textSize="15sp" />

        <LinearLayout
            android:id="@+id/lyricsGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="30dp"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/desktop_lyrics_size_label"
                android:textColor="@color/text_hint"
                android:textSize="13sp" />

            <RadioGroup
                android:id="@+id/rgDesktopSize"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/rbDesktopSizeS"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:tag="0"
                    android:text="@string/size_small"
                    android:textColor="@color/text_primary" />

                <RadioButton
                    android:id="@+id/rbDesktopSizeM"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:tag="1"
                    android:text="@string/size_medium"
                    android:textColor="@color/text_primary" />

                <RadioButton
                    android:id="@+id/rbDesktopSizeL"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:tag="2"
                    android:text="@string/size_large"
                    android:textColor="@color/text_primary" />
            </RadioGroup>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/desktop_lyrics_alpha_label"
                android:textColor="@color/text_hint"
                android:textSize="13sp" />

            <RadioGroup
                android:id="@+id/rgDesktopAlpha"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/rbDesktopAlpha0"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:tag="0"
                    android:text="@string/desktop_lyrics_alpha_0"
                    android:textColor="@color/text_primary" />

                <RadioButton
                    android:id="@+id/rbDesktopAlpha1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:tag="1"
                    android:text="@string/desktop_lyrics_alpha_1"
                    android:textColor="@color/text_primary" />

                <RadioButton
                    android:id="@+id/rbDesktopAlpha2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:tag="2"
                    android:text="@string/desktop_lyrics_alpha_2"
                    android:textColor="@color/text_primary" />
            </RadioGroup>

            <CheckBox
                android:id="@+id/chkLyricsLocked"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/desktop_lyrics_locked"
                android:textColor="@color/text_primary"
                android:textSize="14sp" />
        </LinearLayout>

        <CheckBox
            android:id="@+id/chkMixAudio"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/mix_audio_label"
            android:textColor="@color/text_primary"
            android:textSize="15sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="30dp"
            android:text="@string/mix_audio_hint"
            android:textColor="@color/text_hint"
            android:textSize="12sp" />

        <CheckBox
            android:id="@+id/chkAlarmPlay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/alarm_play"
            android:textColor="@color/text_primary"
            android:textSize="15sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="30dp"
            android:text="@string/alarm_play_hint"
            android:textColor="@color/text_hint"
            android:textSize="12sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/lyric_size_label"
            android:textColor="@color/text_hint"
            android:textSize="13sp" />

        <RadioGroup
            android:id="@+id/rgLyricSize"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/rbLyricSmall"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:tag="15"
                android:text="@string/size_small"
                android:textColor="@color/text_primary" />

            <RadioButton
                android:id="@+id/rbLyricMid"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:tag="18"
                android:text="@string/size_medium"
                android:textColor="@color/text_primary" />

            <RadioButton
                android:id="@+id/rbLyricLarge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:tag="22"
                android:text="@string/size_large"
                android:textColor="@color/text_primary" />
        </RadioGroup>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/ui_size_label"
            android:textColor="@color/text_hint"
            android:textSize="13sp" />

        <RadioGroup
            android:id="@+id/rgUiSize"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/rbUiSmall"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:tag="13"
                android:text="@string/size_small"
                android:textColor="@color/text_primary" />

            <RadioButton
                android:id="@+id/rbUiStd"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:tag="15"
                android:text="@string/size_standard"
                android:textColor="@color/text_primary" />

            <RadioButton
                android:id="@+id/rbUiLarge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:tag="17"
                android:text="@string/size_large"
                android:textColor="@color/text_primary" />
        </RadioGroup>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/lib_layout"
            android:textColor="@color/text_hint"
            android:textSize="13sp" />

        <RadioGroup
            android:id="@+id/rgLibLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/rbLibGrid"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:tag="0"
                android:text="@string/lib_grid"
                android:textColor="@color/text_primary" />

            <RadioButton
                android:id="@+id/rbLibTree"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:tag="1"
                android:text="@string/lib_tree"
                android:textColor="@color/text_primary" />
        </RadioGroup>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/lyric_font_label"
            android:textColor="@color/text_hint"
            android:textSize="13sp" />

        <RadioGroup
            android:id="@+id/rgFont"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/rbFontDefault"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:tag="0"
                android:text="@string/font_default"
                android:textColor="@color/text_primary" />

            <RadioButton
                android:id="@+id/rbFontSerif"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:tag="1"
                android:text="@string/font_serif"
                android:textColor="@color/text_primary" />

            <RadioButton
                android:id="@+id/rbFontMono"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:tag="2"
                android:text="@string/font_mono"
                android:textColor="@color/text_primary" />
        </RadioGroup>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnRescanNow"
                style="@style/BtnStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:text="@string/rescan" />

            <Button
                android:id="@+id/btnChangeFolder"
                style="@style/BtnStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/change_folder" />
        </LinearLayout>

        <Button
            android:id="@+id/btnAbout"
            style="@style/BtnStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/about" />

        <Button
            android:id="@+id/btnTransSettings"
            style="@style/BtnStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/trans_settings" />

        <Button
            android:id="@+id/btnEqSettings"
            style="@style/BtnStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/eq_entry" />

        <Button
            android:id="@+id/btnTheme"
            style="@style/BtnStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/theme_entry" />

    </LinearLayout>
</ScrollView>
