<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <include layout="@layout/page_discover" />

        <include layout="@layout/page_library" />

        <include layout="@layout/page_playlist" />

        <include layout="@layout/page_search" />

        <include layout="@layout/page_player" />

        <include layout="@layout/page_lyrics" />

        <include layout="@layout/page_favorites" />

        <include layout="@layout/page_playlists" />

        <include layout="@layout/page_video" />
        <include layout="@layout/page_videos" />

        <!--
          批量操作栏（2.15 批量删除）：进入多选模式时覆盖在页面顶部。
          做成覆盖层而不是挤压布局，是为了避免进入/退出时列表跳动；
          同时它盖住页面自己的标题栏，视觉上明确表达「已进入选择模式」。
        -->
        <LinearLayout
            android:id="@+id/batchBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:background="@color/surface"
            android:elevation="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:visibility="gone">

            <Button
                android:id="@+id/btnBatchCancel"
                style="@style/BtnStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="64dp"
                android:text="@string/batch_cancel" />

            <TextView
                android:id="@+id/txtBatchCount"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:textColor="@color/text_primary"
                android:textSize="15sp" />

            <Button
                android:id="@+id/btnBatchAll"
                style="@style/BtnStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="64dp"
                android:text="@string/batch_select_all" />

            <Button
                android:id="@+id/btnBatchDelete"
                style="@style/BtnStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="64dp"
                android:text="@string/batch_delete" />
        </LinearLayout>

    </FrameLayout>

    <!-- 全局迷你播放条 -->
    <LinearLayout
        android:id="@+id/miniPlayer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_mini"
        android:orientation="vertical"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:visibility="gone">

        <SeekBar
            android:id="@+id/miniSeekBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="0"
            android:maxHeight="5dp"
            android:minHeight="5dp"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:paddingTop="0dp"
            android:paddingBottom="0dp"
            android:progressTint="@color/accent" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="6dp"
            android:paddingEnd="2dp"
            android:paddingTop="2dp">

            <TextView
                android:id="@+id/txtMiniTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="middle"
                android:singleLine="true"
                android:textColor="@color/text_primary"
                android:textSize="14sp" />

            <Button
                android:id="@+id/btnMiniPlay"
                style="@style/BtnStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:drawablePadding="6dp"
                android:drawableStart="@drawable/ic_play"
                android:minWidth="72dp"
                android:text="@string/play" />
        </LinearLayout>
    </LinearLayout>

    <!-- 底部导航（动态生成：用户可自定义增删/排序/默认页） -->
    <LinearLayout
        android:id="@+id/bottomNav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface"
        android:orientation="horizontal"
        android:paddingTop="6dp"
        android:paddingBottom="10dp" />

</LinearLayout>
