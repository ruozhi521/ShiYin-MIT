<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingTop="8dp"
    android:paddingBottom="8dp"
    android:paddingStart="6dp"
    android:paddingEnd="6dp"
    android:foreground="?attr/selectableItemBackground">

    <!--
      多选勾选框（2.15 批量删除）：默认隐藏，进入批量模式才显示。
      放最左、且进入批量模式时隐藏序号——避免「序号 + 勾选」两个数字并排看混。
    -->
    <ImageView
        android:id="@+id/imgCheck"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginEnd="4dp"
        android:contentDescription="@string/batch_select"
        android:src="@drawable/ic_check_off"
        android:visibility="gone" />

    <ImageView
        android:id="@+id/imgCover"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="@drawable/bg_cover"
        android:clipToOutline="true"
        android:contentDescription="@string/cover"
        android:scaleType="centerCrop"
        android:src="@drawable/ic_music_tinted" />

    <TextView
        android:id="@+id/txtSongIndex"
        android:layout_width="24dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:gravity="center"
        android:textColor="@color/text_hint"
        android:textSize="13sp" />

    <!--
      3.1.1：文件名改「最多两行、末尾省略」（原来是单行 + ellipsize=middle）。
      粉丝反馈：「音频文件名称只能看到前几个字跟后几个字，可以自动换行显示吗，
      有些文件名称会加一大串修饰词，有二三十字那么长」。
      ellipsize="middle" 单行时把长名字压成「前几个字…后几个字」，中间的曲名信息全丢；
      换成两行 + 末尾省略后，二十几个字基本能完整显示，实在超长也只截尾部。
    -->
    <TextView
        android:id="@+id/txtSongTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_weight="1"
        android:ellipsize="end"
        android:maxLines="2"
        android:textColor="@color/text_primary"
        android:textSize="15sp" />

    <TextView
        android:id="@+id/txtHasLyric"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:text="♪"
        android:textColor="@color/accent"
        android:textSize="15sp"
        android:visibility="gone" />

    <!--
      拖拽把手（2.14）：只有歌单页（可排序）才显示。
      存在的意义是**把手势分开**：按住这里 = 拖拽排序，长按其它区域 = 弹菜单。
      全部用长按会让「排序」与「打开菜单」抢同一个手势（用户当场指出的冲突）。
      放右端而不是左端：① 是 iOS/Android 的通行位置；② 不打乱封面/序号的既有顺序。
    -->
    <ImageView
        android:id="@+id/imgDragHandle"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginStart="6dp"
        android:contentDescription="@string/song_drag_handle"
        android:padding="4dp"
        android:src="@drawable/ic_drag_handle"
        android:visibility="gone" />

</LinearLayout>
