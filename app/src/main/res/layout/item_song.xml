<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingTop="8dp"
    android:paddingBottom="8dp"
    android:paddingStart="6dp"
    android:paddingEnd="6dp"
    android:foreground="?attr/selectableItemBackground">

    <ImageView
        android:id="@+id/imgCover"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="@drawable/bg_cover"
        android:clipToOutline="true"
        android:contentDescription="@string/cover"
        android:scaleType="centerCrop"
        android:src="@drawable/ic_music_tinted" />

    <TextView
        android:id="@+id/txtSongIndex"
        android:layout_width="24dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:gravity="center"
        android:textColor="@color/text_hint"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/txtSongTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_weight="1"
        android:ellipsize="middle"
        android:singleLine="true"
        android:textColor="@color/text_primary"
        android:textSize="15sp" />

    <TextView
        android:id="@+id/txtHasLyric"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:text="♪"
        android:textColor="@color/accent"
        android:textSize="15sp"
        android:visibility="gone" />

    <!--
      拖拽把手（2.14）：只有歌单页（可排序）才显示。
      存在的意义是**把手势分开**：按住这里 = 拖拽排序，长按其它区域 = 弹菜单。
      全部用长按会让「排序」与「打开菜单」抢同一个手势（用户当场指出的冲突）。
      放右端而不是左端：① 是 iOS/Android 的通行位置；② 不打乱封面/序号的既有顺序。
    -->
    <ImageView
        android:id="@+id/imgDragHandle"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginStart="6dp"
        android:contentDescription="@string/song_drag_handle"
        android:padding="4dp"
        android:src="@drawable/ic_drag_handle"
        android:visibility="gone" />

</LinearLayout>
