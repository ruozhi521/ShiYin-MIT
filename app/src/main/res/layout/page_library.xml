<?xml version="1.0" encoding="utf-8"?>
<!--
  2.16：音乐库页头部尺寸改为可覆盖的资源值。
  原因：横屏（1080px 高）时 miniPlayer(200px) + bottomNav(273px) 已占 473px，
  pageLibrary 只剩 544px；「28sp 标题 + 20dp×3 间距 + 上下 20dp padding」几乎把它耗光，
  weight=1 的网格区只剩约 24px ≈ 0 → 横屏音乐库完全看不到歌单
  （dump 里连 recyclerPlaylists 节点都没有）。
  这里给出竖屏原值（竖屏外观一字不变），横屏在 values-land 里给压缩值。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/pageLibrary"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp">
    <!-- 3.0：字号由 28sp 提到 30sp，与发现页一致（目标稿两页标题同属 .title，本应同字号） -->
    <TextView android:id="@+id/txtLibraryTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/tab_library" android:textSize="30sp" android:textStyle="bold" android:textColor="@color/text_primary" />

    <!--
      3.0：补一行副标题，使本页头部结构与发现页**逐行对齐**。
      此前本页是「标题（带 20dp marginBottom）→ 搜索栏」，发现页是
      「标题 → 副标题 → 搜索栏」——两页都没错，但切页时搜索栏会**上下跳 50px**，
      弱志反馈「希望发现和音乐库界面的搜索栏在同一位置」。

      目标稿两个面板的头部是统一的三行（标题 y=150 / 副标题 y=176 / 搜索框 y=225），
      所以这里补齐中间那行，并让两页的间距、字号完全一致：
        标题 28sp → 副标题 marginTop 6dp、13sp → 搜索行 marginTop 16dp
    -->
    <TextView android:id="@+id/txtLibrarySubtitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:textColor="@color/text_hint" android:textSize="13sp" />

    <!-- 3.0.4：加 id，供「顶部标题栏」三档自定义动态调边距 -->
    <LinearLayout
        android:id="@+id/libSearchRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <EditText
            android:id="@+id/searchEntry"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:background="@drawable/bg_mini"
            android:clickable="true"
            android:cursorVisible="false"
            android:focusable="false"
            android:gravity="center_vertical"
            android:hint="@string/search_hint"
            android:inputType="text"
            android:maxLines="1"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_hint"
            android:textSize="14sp" />

        <!-- 3.0.4：切换栏隐藏时，歌单排序入口挪到这里（否则用户再也改不了排序） -->
        <TextView
            android:id="@+id/btnSortInline"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_mini"
            android:contentDescription="@string/playlist_sort"
            android:gravity="center"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="⌄"
            android:textColor="@color/text_normal"
            android:textSize="18sp"
            android:visibility="gone" />

        <Button
            android:id="@+id/btnSettings"
            style="@style/BtnStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:minWidth="64dp"
            android:text="@string/settings" />
    </LinearLayout>

    <!-- 3.0.4：加 id，供「显示歌单/歌手切换栏」开关整行隐藏 -->
    <LinearLayout
        android:id="@+id/libSegRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:background="@drawable/bg_segment_track"
        android:orientation="horizontal"
        android:padding="3dp">

        <TextView
            android:id="@+id/segPlaylists"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/bg_segment_active"
            android:gravity="center"
            android:padding="8dp"
            android:text="@string/segment_playlists"
            android:textColor="@color/text_primary"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/segArtists"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:padding="8dp"
            android:text="@string/segment_artists"
            android:textColor="@color/text_hint"
            android:textSize="14sp" />

        <!-- 歌单排序入口（2.13）：放在整行最右端，不破坏「歌单/歌手」两等分布局；
             只在「歌单」分段显示（排序对歌手视图无意义） -->
        <TextView
            android:id="@+id/btnPlaylistSort"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:background="?attr/selectableItemBackground"
            android:contentDescription="@string/playlist_sort"
            android:gravity="center"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:text="⌄"
            android:textColor="@color/text_normal"
            android:textSize="18sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/txtTreePath"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:ellipsize="start"
        android:focusable="true"
        android:gravity="center_vertical"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:singleLine="true"
        android:textColor="@color/text_primary"
        android:textSize="13sp"
        android:visibility="gone" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="20dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerPlaylists"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingBottom="8dp" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerArtists"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingBottom="8dp"
            android:visibility="gone" />

        <!--
          3.0.4：首字母快捷导航（默认关闭，设置 → 媒体库 里开）。
          3.0.4 修订：改为自绘控件 [AlphaIndexBar] —— 按微信通讯录的用法，
          按住可以**拖动**连续选字母，当前字母高亮，并在屏幕中央弹大气泡提示。
        -->
        <com.example.subtitleplayer.AlphaIndexBar
            android:id="@+id/alphaIndexBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end|center_vertical"
            android:layout_marginEnd="2dp"
            android:visibility="gone" />

        <!-- 拖动时的中央气泡（显示当前选中的字母） -->
        <TextView
            android:id="@+id/alphaBubble"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_alpha_bubble"
            android:gravity="center"
            android:textColor="@color/white"
            android:textSize="32sp"
            android:textStyle="bold"
            android:visibility="gone" />
    </FrameLayout>

</LinearLayout>
