<?xml version="1.0" encoding="utf-8"?>
<!--
  2.16：音乐库页头部尺寸改为可覆盖的资源值。
  原因：横屏（1080px 高）时 miniPlayer(200px) + bottomNav(273px) 已占 473px，
  pageLibrary 只剩 544px；「28sp 标题 + 20dp×3 间距 + 上下 20dp padding」几乎把它耗光，
  weight=1 的网格区只剩约 24px ≈ 0 → 横屏音乐库完全看不到歌单
  （dump 里连 recyclerPlaylists 节点都没有）。
  这里给出竖屏原值（竖屏外观一字不变），横屏在 values-land 里给压缩值。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/pageLibrary"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/tab_library" android:textSize="28sp" android:textStyle="bold" android:textColor="@color/text_primary" android:layout_marginBottom="20dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <EditText
            android:id="@+id/searchEntry"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/bg_mini"
            android:clickable="true"
            android:cursorVisible="false"
            android:focusable="false"
            android:hint="@string/search_hint"
            android:inputType="text"
            android:maxLines="1"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="9dp"
            android:paddingBottom="9dp"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_hint"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btnSettings"
            style="@style/BtnStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:minWidth="64dp"
            android:text="@string/settings" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:background="@drawable/bg_segment_track"
        android:orientation="horizontal"
        android:padding="3dp">

        <TextView
            android:id="@+id/segPlaylists"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/bg_segment_active"
            android:gravity="center"
            android:padding="8dp"
            android:text="@string/segment_playlists"
            android:textColor="@color/text_primary"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/segArtists"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:padding="8dp"
            android:text="@string/segment_artists"
            android:textColor="@color/text_hint"
            android:textSize="14sp" />

        <!-- 歌单排序入口（2.13）：放在整行最右端，不破坏「歌单/歌手」两等分布局；
             只在「歌单」分段显示（排序对歌手视图无意义） -->
        <TextView
            android:id="@+id/btnPlaylistSort"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:background="?attr/selectableItemBackground"
            android:contentDescription="@string/playlist_sort"
            android:gravity="center"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:text="⌄"
            android:textColor="@color/text_normal"
            android:textSize="18sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/txtTreePath"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:ellipsize="start"
        android:focusable="true"
        android:gravity="center_vertical"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:singleLine="true"
        android:textColor="@color/text_primary"
        android:textSize="13sp"
        android:visibility="gone" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="20dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerPlaylists"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingBottom="8dp" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerArtists"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingBottom="8dp"
            android:visibility="gone" />
    </FrameLayout>

</LinearLayout>
