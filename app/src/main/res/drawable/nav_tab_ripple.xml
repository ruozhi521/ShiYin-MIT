<?xml version="1.0" encoding="utf-8"?>
<!--
  3.1：底部导航 tab 的按下反馈。

  为什么必须换掉原来的做法：之前这里用 `android.R.drawable.list_selector_background`，
  那是系统给 ListView 用的选择器 —— 它的按下态在不少 ROM/主题下是**琥珀黄色块**，
  按一下导航就闪黄，和 App 的整体配色完全冲突（弱志反馈「难看」）。

  改成 ripple：颜色取 `?attr/colorControlHighlight`，跟随主题 accent 自动生成
  半透明版本 —— 换主题色时反馈色跟着变，不会再出现写死的黄。
  mask 用圆角矩形，让水波被限制在 tab 的圆角范围内（否则会溢出到导航块边缘）。
-->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="?attr/colorControlHighlight">
    <item android:id="@android:id/mask">
        <shape android:shape="rectangle">
            <corners android:radius="12dp" />
            <solid android:color="#FFFFFFFF" />
        </shape>
    </item>
</ripple>
