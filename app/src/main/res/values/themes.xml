<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.SubtitlePlayer" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:navigationBarColor">@color/bg</item>
        <!-- 勾选框/单选框/输入线等控件统一用品牌蓝（原 AppCompat 默认粉色） -->
        <item name="colorAccent">@color/accent</item>
        <!-- 全局弹窗统一为圆角 + 跟随主题底色 -->
        <item name="alertDialogTheme">@style/ShiYinAlertDialog</item>
    </style>

    <style name="ShiYinAlertDialog" parent="Theme.AppCompat.DayNight.Dialog.Alert">
        <item name="colorAccent">@color/accent</item>
        <!--
          3.1 修：弹窗圆角。两个条件必须同时满足，缺一个就还是直角。

          1. 窗口背景必须是**带 inset 的透明 shape**（bg_dialog_window）。
             Dialog 的窗口尺寸按面板 wrap_content 算；若窗口背景不占空间，
             窗口就正好等于面板大小，面板圆角紧贴窗口边界、被窗口自身裁掉 ——
             这就是前两次改了却仍是直角的真正原因：不是圆角没设，而是
             **圆角没有可绘制的空间**。inset 12dp 让窗口比面板大一圈。
             面板自己的圆角与裁切在 applyDialogCorners() 里设置。
          2. 面板自身不能再涂一层实心底，否则会盖住圆角（见下面 colorBackgroundFloating）。
        -->
        <item name="android:windowBackground">@drawable/bg_dialog_window</item>
        <!--
          AppCompat 的 abc_alert_dialog_material 会给面板上一块
          ?attr/colorBackgroundFloating 的实心色，它铺满整个窗口，
          把 windowBackground 上的圆角盖成直角。设为透明后圆角才露得出来。
          ⚠️ 注意用的是**无前缀**的库属性名：android: 前缀那个是系统属性，
          和 AppCompat 布局实际读取的不是同一个，改它没用。
        -->
        <item name="colorBackgroundFloating">@android:color/transparent</item>
        <!-- 圆角半径也统一，供仍走 AppCompat 默认背景的弹窗使用 -->
        <item name="dialogCornerRadius">24dp</item>
    </style>

    <style name="BtnStyle" parent="Widget.AppCompat.Button">
        <item name="android:background">?attr/selectableItemBackgroundBorderless</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:elevation">0dp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">13sp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:paddingTop">9dp</item>
        <item name="android:paddingBottom">9dp</item>
        <item name="android:paddingStart">10dp</item>
        <item name="android:paddingEnd">10dp</item>
    </style>

    <!--
      迷你播放条的紧凑按钮（3.0）。
      为什么必须单独一个：BtnStyle 的 minHeight = 48dp + padding 上下各 9dp，
      会把迷你条内的播放按钮撑到 48dp 起，整个小条实测高 200px ≈ 76dp，
      在实机上「上下占比过大」（弱志反馈）。
      这里压到 36dp（图标 20dp + 上下各 8dp 留白）——仍远高于手势识别的下限，
      但视觉上收紧了。**不动 BtnStyle 本身**：页面里的大按钮还需要 48dp 的点击区。
    -->
    <style name="MiniBtnStyle" parent="BtnStyle">
        <item name="android:minHeight">36dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:paddingTop">4dp</item>
        <item name="android:paddingBottom">4dp</item>
        <item name="android:paddingStart">8dp</item>
        <item name="android:paddingEnd">8dp</item>
        <item name="android:textSize">12sp</item>
    </style>

</resources>
