<?xml version="1.0" encoding="utf-8"?>
<com.example.subtitleplayer.SwipeFrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/pagePlayer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp"
    android:visibility="gone">

    <LinearLayout
        android:id="@+id/playerHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnBackSongs"
            style="@style/BtnStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="64dp"
            android:text="@string/back" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/txtPlayerTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="middle"
                android:gravity="center"
                android:singleLine="true"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtPlayerFolder"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="middle"
                android:gravity="center"
                android:singleLine="true"
                android:textColor="@color/text_hint"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/btnFavorite"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="10dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/favorite"
            android:padding="10dp"
            android:text="♡"
            android:textColor="@color/text_hint"
            android:textSize="24sp" />

        <Button
            android:id="@+id/btnLyrics"
            style="@style/BtnStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="48dp"
            android:text="@string/lyric_btn" />
    </LinearLayout>

    <!-- CD 唱片区 -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="10dp"
        android:layout_weight="1">

        <ImageView
            android:id="@+id/imgCd"
            android:layout_width="260dp"
            android:layout_height="260dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_play_circle"
            android:clipToOutline="true"
            android:contentDescription="@string/cover"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_music_tinted" />

        <ImageView
            android:id="@+id/imgCdHole"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_cd_hole"
            android:contentDescription="@string/cd_hole" />
    </FrameLayout>

    <!-- 当前歌词行 -->
    <TextView
        android:id="@+id/txtNowLyric"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:ellipsize="middle"
        android:gravity="center"
        android:singleLine="true"
        android:text="@string/no_lyric_now"
        android:textColor="@color/accent"
        android:textSize="18sp"
        android:textStyle="bold" />

    <!-- 沉浸模式歌词（多行） -->
    <TextView
        android:id="@+id/txtImmersiveLyric"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center"
        android:lineSpacingExtra="6dp"
        android:textSize="16sp"
        android:textColor="@color/text_primary"
        android:visibility="gone" />

    <SeekBar
        android:id="@+id/seekBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:max="0" />

    <TextView
        android:id="@+id/txtTime"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="00:00 / 00:00"
        android:textColor="@color/text_primary"
        android:textSize="13sp" />

    <!-- 主控行：上一首 / 播放 / 下一首 -->
    <LinearLayout
        android:id="@+id/playerControlsMain"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/btnPrev"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/prev"
            android:src="@drawable/ic_prev"
            android:tint="?attr/colorControlNormal" />

        <ImageButton
            android:id="@+id/btnPlayPlayer"
            android:layout_width="76dp"
            android:layout_height="76dp"
            android:layout_marginStart="18dp"
            android:layout_marginEnd="18dp"
            android:background="@drawable/bg_play_circle"
            android:contentDescription="@string/play"
            android:src="@drawable/ic_play" />

        <ImageButton
            android:id="@+id/btnNext"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/next"
            android:src="@drawable/ic_next"
            android:tint="?attr/colorControlNormal" />
    </LinearLayout>

    <!-- 功能行：定时 / 播放模式 / 队列 / 全屏歌词 -->
    <LinearLayout
        android:id="@+id/playerControlsExtra"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:gravity="center"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/btnTimer"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/timer"
            android:src="@drawable/ic_timer"
            android:tint="?attr/colorControlNormal" />

        <ImageButton
            android:id="@+id/btnPlayMode"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="28dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/play_mode_sequence"
            android:src="@drawable/ic_repeat"
            android:tint="?attr/colorControlNormal" />

        <ImageButton
            android:id="@+id/btnQueue"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="28dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/queue"
            android:src="@drawable/ic_queue"
            android:tint="?attr/colorControlNormal" />

        <ImageButton
            android:id="@+id/btnLyricsIcon"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="28dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/lyrics_full"
            android:src="@drawable/ic_lyric"
            android:tint="?attr/colorControlNormal" />

        <ImageButton
            android:id="@+id/btnVideo"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="28dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/video_btn"
            android:src="@drawable/ic_video"
            android:tint="?attr/colorControlNormal"
            android:visibility="gone" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/playerControlsSeek"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btnSeekBack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_mini"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:text="-10s"
            android:textColor="@color/text_primary"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/btnSpeed"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:background="@drawable/bg_mini"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:text="1x"
            android:textColor="@color/text_primary"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/btnSeekForward"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:background="@drawable/bg_mini"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:text="+10s"
            android:textColor="@color/text_primary"
            android:textSize="13sp" />
    </LinearLayout>

</com.example.subtitleplayer.SwipeFrameLayout>
